{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for all Focus Desktop windows (v1.2)",
  "windows": ["desktop", "chat", "stats", "music", "pet", "pet-bubble", "workflow", "grid-overlay", "topbar"],
  "permissions": [
    "core:default",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-ignore-cursor-events",
    "opener:default",
    "opener:allow-open-path",
    "dialog:default"
  ]
}